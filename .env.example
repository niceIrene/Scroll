# Copy to .env at repo root; the run scripts source it automatically.
# Fill in only the providers you actually use.

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Alibaba DashScope (OpenAI-compatible mode) ---
# Used by the shipped configs under configs/longmemeval/.
# US endpoint:
# US_DASHSCOPE_API_KEY=sk-...
# US_DASHSCOPE_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
# CN endpoint:
# CN_DASHSCOPE_API_KEY=sk-...
# CN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
